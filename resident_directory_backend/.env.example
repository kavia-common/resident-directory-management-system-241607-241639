# PostgreSQL connection (provided by resident_directory_database container)
POSTGRES_URL=localhost
POSTGRES_PORT=5000
POSTGRES_DB=myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123

# Admin auth
# Generate a bcrypt hash (example in Python):
#   from passlib.hash import bcrypt; print(bcrypt.hash("your-password"))
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
